# Copy to .env.local for local overrides, or set this in your hosting
# provider's dashboard (e.g. Vercel: Project Settings -> Environment Variables).
#
# Leave UNSET for local dev — Vite's proxy (vite.config.js) handles routing
# "/api" and "/ws" to http://127.0.0.1:5000 automatically.
#
# Set this when deploying the frontend somewhere static (Vercel, Netlify,
# GitHub Pages, ...) so it knows where your deployed backend actually lives:
VITE_API_BASE=https://your-backend.onrender.com
